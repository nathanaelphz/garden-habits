# Postgres connection string (Neon / Supabase / local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/garden

# Single-user login
APP_PASSWORD=change-me
# Any long random string: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Only used to create your profile on first visit; change them later in You.
APP_USER_NAME=Nathanael
APP_TIMEZONE=Asia/Kuala_Lumpur

# Reminders (web push). Generate the pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# The scheduler sends: Authorization: Bearer <CRON_SECRET>. Any long random string.
CRON_SECRET=
